# Copia este archivo como .env y rellena las claves. El .env NUNCA se sube a GitHub.

# LiveKit (cloud.livekit.io -> Settings -> API Keys)
LIVEKIT_URL=wss://TU-PROYECTO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Oído: Deepgram (console.deepgram.com)
DEEPGRAM_API_KEY=
# Palabras clave de marcas (se cobran aparte, ~0,0013 $/min). 0 = desactivadas (por defecto)
DEEPGRAM_PALABRAS_CLAVE=0

# Cerebro: Claude Haiku 5.5 (console.anthropic.com) o Gemini (aistudio.google.com)
LLM_PROVEEDOR=anthropic
LLM_MODELO=claude-haiku-5-5
ANTHROPIC_API_KEY=
# LLM_PROVEEDOR=google
# LLM_MODELO=gemini-3.5-flash
# GOOGLE_API_KEY=

# Voz: Inworld (inworld.ai -> API Keys). Elegir una voz de España en el Playground de Inworld.
TTS_PROVEEDOR=inworld
INWORLD_API_KEY=
INWORLD_MODELO=inworld-tts-2-flash
INWORLD_VOZ=Ignacio
# Alternativas (más caras): TTS_PROVEEDOR=cartesia + CARTESIA_API_KEY + CARTESIA_VOZ_ID
#                           TTS_PROVEEDOR=elevenlabs + ELEVEN_API_KEY + ELEVENLABS_VOZ_ID

# Detección de fin de turno: v1-mini (local, gratis) o v1 (nube de LiveKit, de pago y algo más precisa)
DETECTOR_TURNOS=v1-mini

# Nombre del agente (debe coincidir con LIVEKIT_AGENTE en el servidor de la web)
AGENTE_NOMBRE=andres
# Segundos de silencio total antes de colgar (pregunta "¿Sigues ahí?" a la mitad)
SILENCIO_SEGUNDOS=15
# Duración máxima de cada llamada (minutos), aviso previo (segundos) y prórroga si ya está dando datos (minutos)
DURACION_MAX_MINUTOS=3
AVISO_ANTES_SEGUNDOS=30
PRORROGA_DATOS_MINUTOS=1.5
