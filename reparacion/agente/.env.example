# Copia este archivo como .env y rellena las claves. El .env NUNCA se sube a GitHub.

# LiveKit Cloud (cloud.livekit.io -> Settings -> API Keys)
LIVEKIT_URL=wss://TU-PROYECTO.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Oído: Deepgram (console.deepgram.com)
DEEPGRAM_API_KEY=

# Cerebro: Claude (console.anthropic.com) o Gemini (aistudio.google.com)
LLM_PROVEEDOR=anthropic
LLM_MODELO=claude-haiku-4-5
ANTHROPIC_API_KEY=
# LLM_PROVEEDOR=google
# LLM_MODELO=gemini-3.5-flash
# GOOGLE_API_KEY=

# Voz: ElevenLabs (recomendado, voz de España) ...
ELEVEN_API_KEY=
ELEVENLABS_VOZ_ID=
# ... o Cartesia si no hay clave de ElevenLabs
# CARTESIA_API_KEY=
# CARTESIA_VOZ_ID=

# Nombre del agente (debe coincidir con LIVEKIT_AGENTE en el servidor de la web)
AGENTE_NOMBRE=andres
# Segundos de silencio total antes de colgar (avisa a la mitad)
SILENCIO_SEGUNDOS=20
# Tope de duración de cada llamada, en minutos
DURACION_MAX_MINUTOS=10
