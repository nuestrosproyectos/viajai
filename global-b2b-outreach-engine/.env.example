# ── Claves de servicios ─────────────────────────────────────────────
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Identidad legal del remitente (aparece en el pie de cada correo) ─
COMPANY_NAME=Tu Empresa, S.L.
TAX_ID=B00000000
FISCAL_ADDRESS=Calle Ejemplo 1, 18001 Granada, España
PRIVACY_URL=https://tudominio.com/privacidad
SENDER_NAME=Nombre Apellido

# URL pública donde escucha el servidor de bajas (sin barra final).
PUBLIC_BASE_URL=https://bajas.tudominio.com

# ── Cumplimiento ────────────────────────────────────────────────────
# true = descarta gmail/hotmail/yahoo... y solo contacta emails corporativos.
STRICT_B2B_ONLY=true
ROBINSON_FILE=external_robinson_blocklist.csv

# ── Webhook de WhatsApp ─────────────────────────────────────────────
# Secreto propio: se envía en la cabecera X-Webhook-Secret o en ?secret=
WEBHOOK_SECRET=cambia-esto-por-una-cadena-larga
# Solo para WhatsApp Cloud API (Meta): verificación del webhook y firma.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Motor de envío ──────────────────────────────────────────────────
ACCOUNTS_FILE=accounts.json
SEND_JITTER_MIN_SECONDS=90
SEND_JITTER_MAX_SECONDS=240
IMAP_CHECK_INTERVAL_SECONDS=600
# Cortafuegos: errores SMTP o rebotes por cuenta y sesión antes de pausarla.
MAX_ACCOUNT_ERRORS=3
MAX_ACCOUNT_BOUNCES=3
# Opcional: URL (Slack, n8n, Make...) que recibe un POST JSON con cada alerta.
ALERT_WEBHOOK_URL=

# ── Varios ──────────────────────────────────────────────────────────
DB_PATH=data/leads.db
LOG_LEVEL=INFO
ENRICH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
