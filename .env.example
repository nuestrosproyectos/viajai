# ─────────────────────────────────────────────────────────────
# Copia este archivo como ".env" y rellena los valores.
# Lo usan el scraper (carpeta /scraper) y n8n (variables $env).
# ─────────────────────────────────────────────────────────────

# Whapi.Cloud → panel > tu canal > "API Token"
WHAPI_TOKEN=pega_aqui_tu_token_de_whapi
# ID del Canal de WhatsApp. Se obtiene con GET https://gate.whapi.cloud/newsletters
# Formato: 120363XXXXXXXXXXXX@newsletter
WHAPI_CHANNEL_ID=120363000000000000@newsletter

# Airtable → https://airtable.com/create/tokens
# Permisos del token: data.records:read y data.records:write sobre tu base
AIRTABLE_TOKEN=pega_aqui_tu_token_de_airtable
# Empieza por "app". Está en la URL de la base: airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_CHOLLOS=Chollos_Flash

# Travelpayouts → Perfil > "API token" y tu "marker" (ID de afiliado)
TRAVELPAYOUTS_TOKEN=pega_aqui_tu_token_de_travelpayouts
TRAVELPAYOUTS_MARKER=123456

# Ajustes del scraper (los valores por defecto ya funcionan)
ORIGENES=MAD,BCN,AGP
PRECIO_MAXIMO=60
MESES_A_CONSULTAR=3
MAX_CHOLLOS_POR_EJECUCION=6
MIN_NOCHES=2
MAX_NOCHES=10
# true = solo muestra lo que insertaría, sin escribir en Airtable
DRY_RUN=false
